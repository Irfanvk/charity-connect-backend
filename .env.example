# Backend Configuration - Copy to .env and update values

# Application Settings
DEBUG=False
APP_NAME=CharityHub Backend
APP_VERSION=1.0.0

# Database Configuration
# Local development: postgresql://postgres:password@localhost:5432/charity_connect
# Production (Heroku): postgres://user:pass@host:port/dbname
DATABASE_URL=postgresql://charity_user:password@localhost:5432/charity_connect

# JWT Settings - Generate strong SECRET_KEY for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# File Upload
MAX_UPLOAD_SIZE_MB=3
UPLOAD_DIR=./app/uploads

# Cloudinary file storage (uploads, avatars, payment proofs)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=charity-connect

# Frontend base URL — used to build invite registration links in WhatsApp messages etc.
# MUST be set to your production domain, e.g. https://poyyathabailgcc.netlify.app
FRONTEND_BASE_URL=https://poyyathabailgcc.com

# CORS Configuration - comma-separated list of allowed origins
# Development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production: https://poyyathabailgcc.com,https://www.poyyathabailgcc.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
BUSINESS_TIMEZONE=Asia/Kolkata
ENABLE_FASTAPI_LIMITER=false

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a key pair (never commit it):  python scripts/generate_vapid_keys.py
# It prints VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY (base64 PEM) ready to paste into
# the Render dashboard for the web, worker and beat services.
# Local dev may point VAPID_PRIVATE_KEY at a .pem file OUTSIDE the repository.
# Legacy WEB_PUSH_PUBLIC_KEY / WEB_PUSH_PRIVATE_KEY / WEB_PUSH_SUBJECT still work as fallback.
# If keys are missing the app starts normally with push disabled (a warning is logged).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@charityhub.app
# ─────────────────────────────────────────────────────────────────────────────

# Import Defaults - Password for newly imported members
IMPORT_DEFAULT_PASSWORD=TempPassword123!
